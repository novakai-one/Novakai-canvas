{
  "name": "@novakai/canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx apps/service/cli/serve.ts",
    "canvas": "tsx apps/cli/cli/canvas.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "architecture": "depcruise capability apps --config .dependency-cruiser.cjs --output-type err",
    "test": "vitest run capability apps",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm architecture && pnpm test",
    "format:check": "prettier --check \"capability/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" eslint.config.js .dependency-cruiser.cjs",
    "tokens:build": "node --import tsx capability/design-system/cli/build-tokens.ts --write",
    "tokens:check": "node --import tsx capability/design-system/cli/build-tokens.ts --check",
    "render:png": "node --import tsx apps/cli/cli/render.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "25.2.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "tsx": "4.23.13"
  }
}
