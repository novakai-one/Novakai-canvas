  node @f-headless concept "adapters/edge/headless.ts" role=warning { text @d "367 lines. The whole render:png job in one file." }
  node @f-sections concept "core/profiles/lint/sections.ts" role=warning { text @d "308 lines. Lint rules for sections." }
  node @f-test concept "tests/commands.test.ts" role=warning { text @d "502 lines. The CLI's only test file." }
  node @f-near concept "Close to 300 lines" size=large { text @d "adapters/inputs/arguments.ts 293, adapters/inputs/semantic-inputs.ts 290." }
  node @f-compose concept "contract/compose/render*.ts" { text @d "5 files, 437 lines. Connects the render's parts." }
  node @f-lint concept "core/profiles/lint/ (4 files)" size=large { text @d "sections/appendix-sequence.ts 142, sections/required.ts 106, appendix-ids.ts 46, sections/identity.ts 32." }
  node @f-gone concept "Removed" { text @d "All apps tests are removed." }
  node @f-spread concept "Both deleted" size=large { text @d "Their work moved to core/commands/, adapters/argv/, core/authoring/, core/reads/ and contract/records/service-answers.ts." }
  node @f-largest note "Target: the 5 largest files, all under 300 lines" size=large { list @l ["core/themes/grammar.ts 232", "contract/errors.ts 213", "adapters/files/resource-reader.ts 213", "core/commands/values.ts 205", "core/themes/lines.ts 202"] }

  wire @fw1 @f-headless -> @t-render "split into" kind=flow
  wire @fw2 @f-headless -> @t-render-io "split into" kind=flow
  wire @fw3 @f-headless -> @f-compose "split into" kind=flow
  wire @fw4 @f-sections -> @f-lint "split into" kind=flow
  wire @fw5 @f-test -> @f-gone "removed" kind=flow
  wire @fw6 @f-near -> @f-spread "deleted" kind=flow

  node @changes-link note "The CLI's 14 behaviour changes, and what stays the same, are in collection 5b · What changes for you: service and CLI (rebuild-5b-service-cli-changes)." size=large {}

  section @s1 "1 · apps/cli in numbers" mode=grid layout=grid columns=2 order=0 {
    show @n-size @n-layers
  }
  section @s2 "2 · Folders — before and target" mode=modules layout=grid columns=2 order=1 {
    group @gb "BEFORE · 44 files, 5,238 lines" layout=grid columns=1 {
      show @b-cli
      group @gb-contract "contract/ · 14 files, 720 lines" layout=grid columns=2 { show @b-contract @b-ports @b-records }
      group @gb-core "core/ · 19 files, 2,336 lines" layout=grid columns=2 { show @b-commands @b-output @b-profiles @b-lint @b-render }
      group @gb-adapters "adapters/ · 8 files, 1,611 lines" layout=grid columns=2 { show @b-inputs @b-edge }
      show @b-tests
    }
    group @gt "TARGET · 109 files, 9,408 lines" layout=grid columns=1 {
      show @t-cli
      group @gt-contract "contract/ · 36 files, 2,288 lines" layout=grid columns=2 { show @t-contract @t-compose @t-records @t-ports }
      group @gt-core "core/ · 60 files, 5,887 lines" layout=grid columns=2 { show @t-commands @t-reads @t-authoring @t-resources @t-presets @t-themes @t-profiles @t-render @t-diagnostics @t-shared }
      group @gt-adapters "adapters/ · 11 files, 1,182 lines" layout=grid columns=2 { show @t-argv @t-http @t-files @t-render-io }
    }
  }
  section @s4 "3 · Who does each job, before and target" mode=grid layout=grid columns=1 order=2 {
    show @jobs
  }
  section @s5 "4 · Import rules and duplicates removed" mode=grid layout=grid columns=2 order=3 {
    show @imports @dupes
  }
  section @s6 "5 · IDs and error codes" mode=grid layout=grid columns=2 order=4 {
    show @ids @codes
  }
  section @s7 "6 · Commands and flags" mode=grid layout=grid columns=2 order=5 {
    show @shape @options
  }
  section @s8 "7 · Files over 300 lines, before and target" mode=flow layout=layered direction=right order=6 {
    show @f-headless @f-sections @f-test @f-near @t-render @t-render-io @f-compose @f-lint @f-gone @f-spread @f-largest
    connect @fw1 @fw2 @fw3 @fw4 @fw5 @fw6
  }
  section @s9 "8 · Behaviour changes" mode=grid layout=grid columns=1 order=7 {
    show @changes-link
  }
}
