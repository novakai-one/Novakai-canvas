  node @rm-node concept "6 · Removed or changed — what you will notice" role=warning size=large {
    table @rm-t columns=["Removed", "Affects", "What it does today", "Plain words — what changes for you", "Risk to weigh"] {
      row @rm-1 cells=["C1 · Shared ID schema objects (folderId, collectionId …)", "Code only (web compose, tests)", "One schema object per ID kind, shared by every importer", "Nothing in the app. Code calls folderIdSchema() instead.", "A missed caller fails typecheck, not at runtime."]
