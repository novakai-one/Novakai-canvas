  node @m-lookups module "lookups.ts" { signature @m-lookups-s "hasFolder / hasEntry / hasCollection" parameters=["records", "id"] returns="boolean" }
  node @m-identities module "identities.ts" { signature @m-identities-s "duplicateIssues" parameters=["items: readonly T[]", "keyOf", "path: string"] returns="readonly Diagnostic[]" }
  node @m-outcomes module "outcomes.ts" { signature @m-outcomes-s "parse / protect / failure / success" parameters=["..."] returns="Result<T>" }
  node @m-filters module "filters.ts" { signature @m-filters-s "filterHits" parameters=["hits", "snapshot", "request"] returns="readonly SearchHit[]" }
  node @m-ranking module "ranking.ts" { signature @m-ranking-s "sortHits" parameters=["hits", "snapshot", "request"] returns="readonly SearchHit[]" }
  node @m-cursor module "cursor.ts" {
