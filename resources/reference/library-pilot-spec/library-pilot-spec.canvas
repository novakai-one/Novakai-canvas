  }
  node @m-versions module "versions.ts" { signature @m-versions-s "readVersions" parameters=["snapshot: LibrarySnapshot"] returns="ReadVersions" }
  node @m-note note "Wires show the function called; the target card carries its signature. Contract schema factories (snapshotSchema, changesSchema, inventorySchema, querySchema, planInputSchema) are imported by validate.ts, plan.ts and query.ts — not drawn." size=medium {}
