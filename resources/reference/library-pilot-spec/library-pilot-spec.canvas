      row @task-5 cells=["5 of 6", "Differential + running-app check", "D2 and D4 pass", "D2, D4"]
      row @task-6 cells=["6 of 6", "Full-folder audit, corrections, <= 1 correction-diff review, records", "D1 and D5 pass", "D1, D5"]
    }
  }

  section @s-today "0 · Situation today — correct behaviour, code below the standard" mode=flow layout=layered direction=right order=0 {
    show @t-caller
    group @g-today "INSIDE capability/library" { show @t-shared @t-args @t-mixed @t-copy }
    show @t-score
    connect @t-w1 @t-w2 @t-w3 @t-w4 @t-w5 @t-w6
  }
  section @s-proposal "0.1 · Proposal — same answers, code at the standard" mode=flow layout=layered direction=right order=1 {
    show @p-caller @p-named @p-fresh @p-one @p-same
    connect @p-w1 @p-w2 @p-w3 @p-w4
  }
  section @s-tree "1 · Target repo tree (capability/library)" mode=tree direction=down gap=compact order=2 {
    show @r-lib @r-contract @r-records @r-core @r-catalog @r-discovery @r-validation @r-tests
    show @f-api @f-brands @f-errors @f-index @f-types @f-rcatalog @f-rchange @f-rquery @f-rcursor @f-rsnapshot
    show @f-ancestry @f-removal @f-operations @f-plan @f-cursor @f-filters @f-project @f-dquery @f-ranking @f-text @f-versions
    show @f-identities @f-lookups @f-outcomes @f-rules @f-validate @f-assertions @f-fixtures @f-tcatalog @f-tplanning @f-tquery
    show @r-note
    connect @r-e1 @r-e2 @r-e3 @r-e4 @r-e5 @r-e6 @r-e7 @r-e8 @r-e9 @r-e10 @r-e11 @r-e12 @r-e13 @r-e14 @r-e15 @r-e15b @r-e16 @r-e17 @r-e18 @r-e19
    connect @r-e20 @r-e21 @r-e22 @r-e23 @r-e24 @r-e25 @r-e26 @r-e27 @r-e28 @r-e29 @r-e30 @r-e31 @r-e32 @r-e33 @r-e34 @r-e35 @r-e36 @r-e37
    root @r-lib
  }
  section @s-er "2 · Entities and invariants — unchanged" mode=er layout=layered order=3 {
    show @e-catalog @e-folder @e-entry @e-collection @e-recent @e-inv
    connect @e-w1 @e-w2 @e-w3 @e-w4 @e-w5 @e-w6
  }
  section @s-modules "3 · Module imports (groups are folders)" mode=modules layout=layered order=4 {
    show @m-note
    group @g-contract "contract/" frame=auto role=neutral layout=layered { show @m-api }
    group @g-core "core/" frame=auto role=neutral layout=layered {
      group @g-catalog "catalog/" frame=auto role=neutral layout=layered { show @m-plan @m-operations @m-removal @m-ancestry }
      group @g-discovery "discovery/" frame=auto role=neutral layout=layered { show @m-dquery @m-project @m-filters @m-ranking @m-cursor @m-text @m-versions }
      group @g-validation "validation/" frame=auto role=neutral layout=layered { show @m-validate @m-rules @m-lookups @m-identities @m-outcomes }
    }
    connect @m-w1 @m-w2 @m-w3 @m-w4 @m-w5 @m-w6 @m-w7 @m-w8 @m-w9 @m-w10 @m-w11
    connect @m-w12 @m-w13 @m-w14 @m-w15 @m-w16 @m-w17 @m-w18 @m-w19 @m-w20 @m-w21 @m-w22
  }
  section @s-summary "4 · Modules summary" mode=flow order=5 { show @sum-node }
  section @s-own "5 · Capability ownership" mode=flow order=6 { show @own-node }
  section @s-removed "6 · Removed or changed" mode=flow order=7 { show @rm-node }
  section @s-done "E1 · Definition of done" mode=flow order=8 { show @done-node }
  section @s-tasks "E2 · Task list" mode=flow order=9 { show @task-node }
}
