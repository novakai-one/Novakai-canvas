canvas 1
collection @library-pilot "Library pilot — code-quality completion of capability/library" description="Rewrite of capability/library to the 16-principle SOP (>144 per file, >145 folder) and the 9 senior TypeScript gates. Approved pilot contract: approved-library-pilot-instructions-verbatim.md." {

  node @t-caller start "A caller asks Library" role=primary size=small { text @t-caller-d "Service plans catalog changes; web searches; CLI and service validate." }
  node @t-shared step "Shared schema objects" size=medium { text @t-shared-d "Every schema is one object created at load time and exported. Any importer can change it, and every later call sees the change." }
  node @t-args step "Unnamed arguments" size=medium { text @t-args-d "plan(snapshot, changes, proposedCollections?) — three unknown values in a fixed order. Easy to swap." }
  node @t-mixed step "Files with two jobs" size=medium { text @t-mixed-d "folders.ts walks ancestry AND removes folders. project.ts compares text, reads versions AND builds hits. The cursor schema sits in the public contract." }
  node @t-copy step "Repeated code" size=medium { text @t-copy-d "Six handlers repeat the same op check. 'Does this folder exist?' is written out in five places." }
  node @t-score end "Audit: 123/160, TypeScript gates fail" role=warning size=medium { text @t-score-d "Behaviour is correct. The code is below the standard." }
  wire @t-w1 @t-caller -> @t-shared "reads schemas" kind=flow
  wire @t-w2 @t-caller -> @t-args "calls" kind=flow
  wire @t-w3 @t-shared -> @t-score "P13 = 0" kind=flow
  wire @t-w4 @t-args -> @t-score "TS gate 6 fails" kind=flow
  wire @t-w5 @t-mixed -> @t-score "P1, P11 low" kind=flow
  wire @t-w6 @t-copy -> @t-score "P6 low" kind=flow

  node @p-caller start "A caller asks Library" role=primary size=small {}
  node @p-fresh step "Schema built per call" size=medium { text @p-fresh-d "folderIdSchema() returns a new schema each time. Nothing shared, nothing to mutate." }
  node @p-named step "One named input" size=medium { text @p-named-d "plan({ snapshot, changes, proposedCollections }) and query({ snapshot, request }). Read inside the protected boundary." }
  node @p-one step "One job per file" size=medium { text @p-one-d "ancestry.ts, removal.ts, text.ts, versions.ts, lookups.ts split out. Cursor schema moves to contract/records/cursor.ts, which index.ts does not export (core never imports zod)." }
  node @p-same end "Same answers for valid input" role=success size=medium { text @p-same-d "Same plans, pages, diagnostics and frozen results. Checked by a differential against 594fda1." }
  wire @p-w1 @p-caller -> @p-named "calls" kind=flow
  wire @p-w2 @p-named -> @p-fresh "parses with" kind=flow
  wire @p-w3 @p-fresh -> @p-one "hands parsed records to" kind=flow
  wire @p-w4 @p-one -> @p-same "returns" kind=flow

