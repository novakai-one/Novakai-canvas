  node @e-catalog entity "Catalog" {
    field @e-catalog-id "id" type="CatalogId" key=primary
    field @e-catalog-v "schemaVersion" type="1"
    field @e-catalog-rev "revision" type="Revision (0..2^53-1)"
  }
  node @e-folder entity "Folder" {
    field @e-folder-id "id" type="FolderId" key=primary
    field @e-folder-parent "parent?" type="FolderId" key=foreign references=@e-folder.@e-folder-id
    field @e-folder-title "title" type="Label (nonblank, <= 10,000)"
    field @e-folder-order "order" type="SafeInteger"
  }
  node @e-entry entity "CatalogEntry" {
    field @e-entry-col "collection" type="CollectionId" key=primary
    field @e-entry-folder "folder?" type="FolderId" key=foreign references=@e-folder.@e-folder-id
    field @e-entry-order "order" type="SafeInteger"
    field @e-entry-arch "archived" type="boolean"
  }
  node @e-collection entity "CollectionProjection" {
    field @e-col-id "id" type="CollectionId" key=primary
    field @e-col-rev "revision" type="Revision"
    field @e-col-title "title" type="Label"
    field @e-col-sections "sections" type="SectionProjection[] (id: SectionId, title: Label)"
    field @e-col-objects "objects" type="ObjectProjection[] (id: ObjectId, label, visibleIn: SectionId[])"
  }
  node @e-recent entity "RecentVisit" {
    field @e-recent-col "collection" type="CollectionId" key=foreign references=@e-collection.@e-col-id
    field @e-recent-at "openedAt" type="Revision"
  }
  node @e-inv note "Unchanged invariants (checked by validate, plan and query):\n(1) folder.id unique; entry.collection unique; collection.id unique; section.id and object.id unique per collection; one visit per collection\n(2) folder.parent in folders.id; entry.folder in folders.id; entry.collection in collections.id; visibleIn subset of sections.id; visit.collection in collections.id\n(3) for every collection, exactly one entry with entry.collection = collection.id\n(4) no folder f with f in ancestors(f)\n(5) |every list| <= 10,000; |changes| <= 1,000; |cursor| <= 1,000,000\nNo stored record changes shape. Only the catalog is persisted (by Authoring)." size=large {}
  wire @e-w1 @e-catalog -> @e-folder "holds (catalog.folders)" kind=association from=1 to=0..many
  wire @e-w6 @e-catalog -> @e-entry "holds (catalog.entries)" kind=association from=1 to=0..many
  wire @e-w2 @e-folder.@e-folder-id -> @e-folder.@e-folder-parent "parent of" kind=association from=0..1 to=0..many
  wire @e-w3 @e-folder.@e-folder-id -> @e-entry.@e-entry-folder "contains" kind=association from=0..1 to=0..many
  wire @e-w4 @e-collection.@e-col-id -> @e-entry.@e-entry-col "listed by" kind=association from=1 to=1
  wire @e-w5 @e-collection.@e-col-id -> @e-recent.@e-recent-col "visited" kind=association from=1 to=0..1

  node @m-api module "api.ts" role=primary {
    signature @m-api-validate "validate" parameters=["input: unknown"] returns="Result<LibrarySnapshot>"
