      row @rm-3 cells=["C3 · Positional arguments to plan and query", "Service planner, web search", "plan(snapshot, changes, proposed?)", "Nothing in the app. Callers pass one named record.", "A throwing getter on the record is a shape failure at $ (same as today for each argument)."]
      row @rm-4 cells=["C4 · Unused diagnostic code 'identity'", "Type only", "Listed, never produced", "Nothing.", "None; no producer or consumer."]
