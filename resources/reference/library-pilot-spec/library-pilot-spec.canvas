      row @done-2 cells=["D2", "Same answers as baseline for valid and invalid input", "Differential: validate / plan / query corpus at 594fda1 vs pilot HEAD through a call-shape adapter", "(records differing) = only C1–C6 rows, each with its expected-outcome check passing"]
      row @done-3 cells=["D3", "Checks pass", "pnpm typecheck; eslint (complexity <= 2); prettier; architecture; TSDoc scan; vitest library, authoring, service, web, cli", "(exit codes = 0) or (failure also present at 594fda1, recorded)"]
      row @done-4 cells=["D4", "The Library works in the running app", "Headless Playwright, isolated data: open library, search, create / rename / move / archive / remove folder, reload, undo", "(every step shows the expected result after reload; console errors = 0 new)"]
      row @done-5 cells=["D5", "Records updated", "Obsidian hub row + tracker", "(score, coverage, exclusions, completion time present)"]
    }
  }

