  node @e-workspace entity "Workspace" {
    field @lifecycle "lifecycle" type="Lifecycle"
    field @link "link" type="Link"
    field @catalogue "catalogue" type="Catalogue"
    field @journal "journal" type="Journal"
    field @history "history" type="History"
    field @source "source" type="SourceEditor"
    field @notices "notices" type="Notices"
    field @diagram "diagram" type="DiagramSession"
    text @i1 "invariant W1: slice(x) changes only inside update_x (x in the 8 fields above); contexts.ts gives read-only copies"
    text @i2 "invariant W2: lifecycle.phase = 'disposed' => transition(s, e) = { state: s, effects: [], events: [] } for every e"
  }
  node @e-rootstep entity "RootStep<Workspace>" {
    field @state "state" type="Workspace"
    field @effects "effects" type="readonly Effect[]"
    field @events "events" type="readonly WorkspaceEvent[]"
    text @i1 "invariant R2: runner applies step.state, then queues step.events (FIFO), then runs step.effects in order"
    text @i2 "invariant: each lift maps an out to a fixed finite list of events; each after-rule is idempotent and queues only the dismissed reactions of entries it removes; entries are finite, so every drain ends"
  }
  node @e-step entity "Step<S, O, E> (one child machine)" {
    field @state "state" type="S"
    field @effects "effects" type="readonly E[] (E = that machine's own effect subset)"
    field @out "out" type="readonly O[]"
    text @i1 "invariant: out is read only by that machine's lift file; no child reads another child's Step"
    text @i2 "invariant J3 (type part): only JournalEffect contains ApplyEffect, so no other machine can return post-apply"
  }
  node @e-effect entity "Effect" {
    field @family "family" type="'service' | 'apply' | 'storage' | 'scene' | 'browser' | 'stores' | 'callers' | 'bridge' (temporary)"
    field @kind "kind" type="EffectKind (closed union, 31 kinds)"
    text @i1 "invariant EF1: every family has exactly one executor, chosen only in compose/executors.ts"
    text @i2 "invariant EF2: an executor does one piece of I/O and answers only with its own answer events (Executor<E, A>); it never calls transition"
  }
  node @e-event entity "WorkspaceEvent" {
    field @to "to" type="MachineName (11 names: the 8 slices + gesture, connection, forms)"
    field @kind "kind" type="EventKind (closed per machine)"
    text @i1 "invariant: route(e) is one exhaustive switch on e.to; a new machine does not compile until it is routed"
  }
  node @e-cell entity "RunnerCell (closure in runner.ts)" {
    field @state "state" type="W"
    field @queue "queue" type="readonly WorkspaceEvent[]"
    field @drain "drain" type="'idle' | 'draining'"
    field @life "life" type="'open' | 'closed'"
    field @view "published" type="V (cached per state reference)"
    text @i1 "invariant R1: drain = 'draining' => dispatch(e) only appends e to queue (no re-entry)"
    text @i2 "invariant R6: life = 'closed' => dispatch(e) is dropped and listeners = {}"
    text @i3 "invariant R2/R8: listeners are notified once the queue is empty; published = project(last notified state)"
  }

  wire @er1 @e-cell.@state -> @e-workspace "holds" kind=association from=1 to=1
  wire @er2 @e-rootstep.@state -> @e-workspace "next state" kind=association from=1 to=1
  wire @er3 @e-rootstep.@effects -> @e-effect "runs" kind=association from=1 to=0..many
  wire @er4 @e-rootstep.@events -> @e-event "queues" kind=association from=1 to=0..many
  wire @er5 @e-cell.@queue -> @e-event "waiting" kind=association from=1 to=0..many
  wire @er6 @e-step.@effects -> @e-effect "passes up" kind=association from=1 to=0..many

