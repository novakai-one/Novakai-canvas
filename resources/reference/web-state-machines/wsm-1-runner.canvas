  section @sequence-51 "7 · Runner loop — event -> transition -> commit -> publish -> effects -> result events" mode=sequence direction=down gap=compact order=9 {
    show @q-you @q-facade @runner @w-machine @c-executors @q-io detail=label size=small
    event @q1 @q-you -> @q-facade "click Add object" kind=call
    event @q2 @q-facade -> @runner "dispatch(forms submitted{object, request}) — IDs minted here, never in core" kind=call
    fragment @q-loop loop "Drain: one event at a time until the queue is empty" {
      event @q3 @runner -> @w-machine "transition(state, event): RootStep<Workspace>" kind=call
      event @q4 @w-machine -> @runner "RootStep — routed by event.to, lifted, finalized (F1–F6); pure" kind=return
      event @q5 @runner -> @q-you "commit state; queue step.events; notify only when the queue is empty (R2)" kind=async
      event @q6 @runner -> @c-executors "queue step.events (FIFO); then execute(effect, dispatch) for each effect in order" kind=call
      event @q7 @c-executors -> @q-io "one piece of I/O — write-journal (before-send)" kind=call
    }
    event @q8 @q-io -> @c-executors "storage answered" kind=return
    event @q9 @c-executors -> @runner "dispatch(journal written ok) — only queues; a new drain starts" kind=async
    event @q10 @runner -> @c-executors "execute(post-apply) — only after the write succeeded (J3)" kind=call
    event @q11 @c-executors -> @q-io "POST /api/v1/authoring/apply" kind=call
    fragment @q-after alt "The answer arrives" {
      branch @q-live "Runner open" {
        event @q12 @c-executors -> @runner "dispatch(journal apply-answered) -> owner, then snapshot (O1–O4)" kind=async
      }
      branch @q-dead "After dispose" {
        event @q13 @c-executors -> @runner "dispatch(…) dropped (R6); the stored journal returns as uncertain on the next load" kind=async
      }
    }
  }
}
