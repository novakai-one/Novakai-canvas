  node @j-send module "send.ts [NEW]" {
    signature @sig "sendWanted" parameters=["state: BoundJournal", "send: SendWanted", "context: GateContext"] returns="Step<Journal, JournalOut, JournalEffect>"
    signature @written "written" parameters=["state: BoundJournal", "purpose: JournalWrite", "result: Result<void>"] returns="Step<Journal, JournalOut, JournalEffect>"
