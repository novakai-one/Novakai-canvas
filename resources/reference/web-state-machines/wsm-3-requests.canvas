  section @repo "1 · Target repo tree — requests ([collection N] = specified there)" mode=tree direction=down gap=compact order=1 {
    show @root @d-web @d-core @d-ws @d-journal @d-history @d-notices @d-rules @d-editing @d-contract @d-records @d-recwf @d-compose @d-adapters @d-effects @d-readers @d-sessions @d-react detail=label size=small
    show @j-state @j-journal @j-send @j-answers @j-recovery @j-restore @j-entries @h-state @h-history @h-gate @h-navigable @h-journal @n-state @n-notices @r-gate @r-classes detail=label size=small
    show @e-submissions @w-journal @w-history @w-notices @w-gate @c-submission @x-compose @x-apply @x-storage @x-readers @x-session @x-retention @x-history-ui @x-recovery-ui @x-eslint detail=label size=small
    connect @t1 @t2 @t3 @t4 @t5 @t6 @t7 @t8 @t9 @t10 @t11 @t12 @t13 @t14 @t14b @t14c @t14d @t14e @t15 @t16 @t17 @t18 @t19 @t20 @t21 @t22 @t23 @t24 @t25 @t26 @t27 @t28 @t29 @t30 @t31 @t32 @t33 @t34 @t35 @t36 @t37 @t38 @t39 @t40 @t41 @t42 @t43 @t44 source-side=bottom target-side=left
    root @root
  }

  node @e-journal entity "BoundJournal" {
    field @workspace "workspace" type="WorkspaceId" key=primary
    field @entries "entries" type="readonly JournalEntry[]"
    field @clock "clock" type="JournalTick"
    text @i1 "invariant J1: for all e in entries: e.request.workspace = workspace"
    text @i2 "invariant J2: for all e1 != e2 not rejected: records(e1) and records(e2) share nothing (one request per collection)"
    text @i3 "invariant: at most one entry with autoCheck = 'waiting' is in phase 'checking'; waiting entries are checked one at a time, in entry order"
  }
  node @e-entry entity "JournalEntry" {
    field @request "request.request" type="RequestId" key=primary
    field @workspace "request.workspace" type="WorkspaceId" key=foreign references=@e-journal.@workspace
    field @generation "generation" type="TransportGeneration"
    field @origin "origin" type="Origin"
    field @started "started" type="JournalTick"
    field @phase "phase" type="recording{after: new | retryable} | sending | uncertain | checking{after} | looking-up{after} | retryable | rejected{refusal: Refusal, at: JournalTick}"
    field @auto "autoCheck" type="'waiting' | 'no' (a restored undo/redo not yet checked)"
    text @i1 "invariant J3: post-apply(r) carries the AdmittedSend and is emitted only after written(before-send r) = ok; only JournalEffect includes ApplyEffect (type), and only journal/send.ts writes it (lint)"
    text @i2 "invariant J5: Retry posts the same Request (same RequestId, same body) with generation = the current one"
    text @i3 "invariant J6: phase in { checking, looking-up } => a second Check or Retry is refused by phase"
  }
  node @e-origin entity "Origin" {
    field @kind "kind" type="'gesture' | 'move-choice' | 'connection' | 'add-form' | 'palette' | 'create-collection' | 'source' | 'history' | 'editor' | 'restored'"
    field @collection "collection" type="CollectionId (all kinds but history, editor, restored)"
    field @gesture "gesture" type="GestureId (gesture, move-choice)"
    field @extra "choice | form | edit | direction | editor" type="ChoiceKind | FormKind | SourceEdit | Direction | EditorKind"
    text @i1 "invariant: a discriminated union; each kind carries exactly the fields listed for it and no others"
  }
  node @e-send entity "SendWanted" {
    field @request "request" type="Request (Authoring)"
    field @generation "generation" type="{ kind: 'captured', generation: TransportGeneration } | { kind: 'current' }"
    field @origin "origin" type="Origin"
    text @i1 "invariant: generation.kind = 'current' <=> origin.kind in { history, create-collection } or the editor is the library; every other origin sends its captured generation"
  }
  node @e-stored entity "StoredSubmission (localStorage, shape unchanged)" {
    field @request "request" type="Request" key=primary
    field @generation "generation" type="TransportGeneration"
    field @edit "sourceEdit" type="SourceEdit"
    field @gesture "gesture" type="GestureId | null (JSON kept; the reader maps it to Origin)"
    field @state "state" type="'sending' | 'uncertain' | 'retryable'"
    text @i1 "invariant J4: an entry with phase 'rejected' is never stored"
    text @i2 "invariant: restore maps every stored entry to phase 'uncertain' and drops entries of another workspace"
  }
  node @e-history entity "History" {
    field @gate "gate" type="Gate: idle | sending{RequestId} | settling{WorkspaceSequence} | caught-up{WorkspaceSequence}"
    field @status "status" type="{ kind: 'unknown' } | { kind: 'known', status: HistoryStatus }"
    field @issued "issued" type="HistoryTicket"
    text @i1 "invariant H1: navigable <=> gate = idle and journal quiet and canvas idle and status known"
    text @i2 "invariant H2: gate != idle => every change send is blocked 'history-held'"
    text @i3 "invariant H3: only rules/history-release.ts (F4) sets gate = idle after settling"
  }
  node @e-notices entity "Notices" {
    field @problem "problem" type="ProblemSlot: none | refusal{RequestId} | failure{FailureShown, Diagnostic}"
    field @note "note" type="StatusNote (5 kinds)"
    field @drafts "drafts" type="readonly CollectionId[]"
    text @i1 "decision D7: status text is never stored; view/status.ts derives it from all slices"
    text @i2 "invariant N1: a refusal slot names an entry in phase rejected; the Diagnostic is read from that entry (stored once)"
  }

  wire @er1 @e-journal.@entries -> @e-entry.@workspace "holds" kind=association from=1 to=0..many
  wire @er2 @e-entry.@origin -> @e-origin "sent by" kind=association from=1 to=1
  wire @er3 @e-send.@origin -> @e-origin "sent by" kind=association from=1 to=1
  wire @er4 @e-entry.@request -> @e-stored.@request "stored as" kind=association from=1 to=0..1
  wire @er5 @e-send.@request -> @e-entry.@request "becomes" kind=association from=1 to=0..1

  section @entities "2 · Entities and invariants — the journal, the undo gate, notices" mode=er direction=right order=2 {
    show @e-journal @e-entry @e-origin @e-send @e-stored @e-history @e-notices
    connect @er1 @er2 @er3 @er4 @er5
  }

  wire @m1 @j-journal -> @j-send "sendWanted · written" kind=imports
  wire @m2 @j-journal -> @j-answers.@sig "applyAnswered(): Step<Journal, JournalOut, JournalEffect>" kind=imports
  wire @m3 @j-journal -> @j-recovery.@sig "updateRecovery(): Step<Journal, JournalOut, JournalEffect>" kind=imports
  wire @m4 @j-journal -> @j-restore.@sig "restoreJournal(): Step<Journal, JournalOut, JournalEffect>" kind=imports
  wire @m5 @j-send -> @r-gate.@sig "gatedSend(mode 'first'): Result<AdmittedSend, SendBlock>" kind=imports
  wire @m6 @j-recovery -> @r-gate.@sig "gatedSend(mode 'resend'): Result<AdmittedSend, SendBlock>" kind=imports
  wire @m7 @x-apply -> @r-classes.@sig "classifyApply() via contract/api.ts: refused or unknown, decided once" kind=imports
  wire @m8 @j-send -> @j-entries "entryOf · storedEntries" kind=imports
  wire @m9 @j-answers -> @j-entries "entryOf · storedEntries" kind=imports
  wire @m10 @j-recovery -> @j-entries "entryOf · storedEntries" kind=imports
  wire @m11 @h-history -> @h-gate.@sig "observeSnapshot(): Gate" kind=imports
  wire @m12 @h-history -> @h-navigable.@sig "navigable(): Permission" kind=imports
  wire @m13 @x-compose -> @x-apply.@sig "createApplyExecutor(): Executor<ServiceEffect>" kind=imports
  wire @m14 @x-compose -> @x-storage.@sig "createStorageExecutor(): Executor<StorageEffect>" kind=imports
  wire @m15 @x-compose -> @x-readers.@sig "createSubmissionReaders(): SubmissionReaders" kind=imports
  wire @m16 @x-compose -> @x-retention.@sig "createDraftRetention(): DraftRetention" kind=imports

  section @modules "3.1 · Module imports — journal, gate, undo/redo" mode=modules layout=layered direction=right order=3 {
    group @g-journal "core/workspace/journal/" {
      show @j-journal @j-send @j-answers @j-recovery @j-restore @j-entries
    }
    group @g-rules "core/workspace/rules/" layout=grid columns=1 {
      show @r-gate @r-classes
    }
    group @g-history "core/workspace/history/" {
      show @h-history @h-gate @h-navigable
    }
    connect @m1 @m2 @m3 @m4 @m5 @m6 @m8 @m9 @m10 @m11 @m12
  }

  section @modules-adapters "3.2 · Module imports — executors are wired only by compose (adapters never import adapters); the apply executor classifies an answer once" mode=modules layout=layered direction=right order=4 {
    group @g-compose "contract/compose/" {
      show @x-compose
    }
    group @g-adapters "adapters/" {
      group @g-aeffects "effects/" layout=grid columns=1 {
        show @x-apply @x-storage
      }
      group @g-areaders "readers/" {
        show @x-readers
      }
      group @g-asessions "sessions/" {
        show @x-retention
      }
    }
    group @g-core2 "core/workspace/" {
      group @g-rules2 "rules/" {
        show @r-classes
      }
    }
    connect @m13 @m14 @m15 @m16 @m7
  }

  node @summary concept "4 · Modules summary — collection 3" size=large {
    table @summary-t columns=["Module", "Current Line Count", "Lines Added", "Lines Removed", "Net", "Expected final line count (estimate)", "What the module does"] {
      row @sm-1 cells=["core/workspace/journal/state.ts", "0", "+80", "0", "+80", "80", "NEW · Journal, JournalEntry (with autoCheck), EntryPhase and JournalEffect."]
      row @sm-2 cells=["core/workspace/journal/journal.ts", "0", "+110", "0", "+110", "110", "NEW · updateJournal: routes each journal event to send, answers, recovery or restore."]
      row @sm-3 cells=["core/workspace/journal/send.ts", "0", "+110", "0", "+110", "110", "NEW · Gate, record, write, then post. The only file that builds post-apply (J3)."]
      row @sm-4 cells=["core/workspace/journal/answers.ts", "0", "+110", "0", "+110", "110", "NEW · Apply answer (already classified by the executor) to confirmed, rejected or uncertain."]
      row @sm-5 cells=["core/workspace/journal/recovery.ts", "0", "+120", "0", "+120", "120", "NEW · Check, Retry (gated resend of the same request) and Dismiss."]
      row @sm-6 cells=["core/workspace/journal/restore.ts", "0", "+90", "0", "+90", "90", "NEW · Loads the stored journal: drops foreign and refused, marks the rest uncertain, queues undo/redo checks."]
      row @sm-7 cells=["core/workspace/journal/entries.ts", "0", "+70", "0", "+70", "70", "NEW · Find, replace and remove entries; entries to stored form."]
      row @sm-8 cells=["core/workspace/history/state.ts", "0", "+40", "0", "+40", "40", "NEW · History, Gate and HistoryKnowledge."]
      row @sm-9 cells=["core/workspace/history/history.ts", "0", "+130", "0", "+130", "130", "NEW · updateHistory: request, settle, snapshot seen, status reads."]
      row @sm-10 cells=["core/workspace/history/gate.ts", "103", "+40", "-63", "-23", "80", "CHANGE · Gate phases: idle, sending, settling, caught-up."]
      row @sm-11 cells=["core/workspace/history/navigable.ts", "0", "+40", "0", "+40", "40", "NEW, moved · navigable() (H1). Moved from history/journal.ts."]
      row @sm-12 cells=["core/workspace/history/journal.ts", "84", "0", "-84", "-84", "0", "DELETE · Split into rules/gated-send.ts and history/navigable.ts."]
      row @sm-13 cells=["core/workspace/notices/state.ts", "0", "+40", "0", "+40", "40", "NEW · Notices, ProblemSlot and StatusNote."]
      row @sm-14 cells=["core/workspace/notices/notices.ts", "0", "+110", "0", "+110", "110", "NEW · updateNotices: report, refuse, dismiss, clear, note."]
      row @sm-15 cells=["core/workspace/rules/gated-send.ts", "0", "+130", "0", "+130", "130", "NEW · sendReadiness (no request needed; also used by may) and gatedSend (adds workspace and record checks). GateContext, SendMode."]
      row @sm-16 cells=["core/workspace/rules/refusal-classes.ts", "0", "+70", "0", "+70", "70", "NEW · classifyApply; frozen answerClass (Authoring codes) and moveRefusal (RefusedCode) tables."]
      row @sm-17 cells=["core/editing/submissions.ts", "75", "0", "-75", "-75", "0", "DELETE · Journal helpers; absorbed by journal/*, rules/refusals.ts and refusal-classes.ts."]
      row @sm-18 cells=["contract/records/workflow/journal.ts", "0", "+130", "0", "+130", "130", "NEW · Origin, SendWanted, RefusedCode, Refusal, Settlement, ApplyAnswer, ReceiptAnswer, JournalEvent."]
      row @sm-19 cells=["contract/records/workflow/history.ts", "0", "+40", "0", "+40", "40", "NEW · HistoryEvent and HistoryOut."]
      row @sm-20 cells=["contract/records/workflow/notices.ts", "0", "+50", "0", "+50", "50", "NEW · NoticesEvent and FailureShown."]
      row @sm-21 cells=["contract/records/workflow/gate.ts", "0", "+30", "0", "+30", "30", "NEW · SendBlock, SendTarget and AdmittedSend. GateContext and SendMode stay in core (C3)."]
      row @sm-22 cells=["contract/records/submission.ts", "63", "+10", "-23", "-13", "50", "CHANGE · Keeps StoredSubmission and CarriedSnapshot only."]
      row @sm-23 cells=["adapters/effects/apply.ts", "0", "+100", "0", "+100", "100", "NEW · POST apply; the receipt must name this request; answers apply-answered."]
      row @sm-24 cells=["adapters/effects/storage.ts", "0", "+120", "0", "+120", "120", "NEW · Journal and source-draft reads and writes through draft-retention."]
      row @sm-25 cells=["adapters/readers/submission-readers.ts", "79", "+40", "-9", "+31", "110", "CHANGE · restoredOrigin: stored fields to Origin and back."]
      row @sm-26 cells=["adapters/sessions/submission-session.ts", "234", "0", "-234", "-234", "0", "DELETE · Hand-built journal; replaced by journal/*."]
      row @sm-27 cells=["adapters/sessions/draft-retention.ts", "53", "+15", "-8", "+7", "60", "CHANGE · Storage keys built only here, from RetentionSlot and WorkspaceId."]
      row @sm-28 cells=["adapters/react/HistoryControls.tsx", "54", "+10", "-19", "-9", "45", "CHANGE · Reads may.undo and may.redo with reasons; no second gate check."]
      row @sm-29 cells=["adapters/react/RequestRecovery.tsx", "100", "+15", "-20", "-5", "95", "CHANGE · Check, Retry and Dismiss read each entry's may fields."]
      row @sm-30 cells=["eslint.config.js (repo root)", "77", "+30", "-4", "+26", "103", "CHANGE · syntax() helper so overrides keep the wildcard-export ban; J3: post-apply literal only in journal/send.ts, send.ts imported only from journal/; ticket imports (M2); core globals (M2)."]
      row @sm-total cells=["TOTAL · 30 files", "922", "+1880", "-539", "+1341", "2263", "Estimates, not gates. Paths are under apps/web/ unless they start with capability/, apps/service/ or name the repo root."]
    }
  }
  section @s-summary "4 · Modules summary — requests" mode=grid columns=1 order=5 {
    show @summary
  }

  node @crud note "5 · Capability ownership — journal, gate, notices" size=large {
    table @crud-t columns=["Object", "Create", "Read", "Update", "Delete"] {
      row @e-journal-row cells=["BoundJournal", "journal/restore.ts — restoreJournal() on 'loaded'", "rules/gated-send.ts; lift/journal.ts; view/journal-view.ts", "journal/send.ts, answers.ts, recovery.ts", "never; replaced when the workspace changes ('bind')"]
      row @e-entry-row cells=["JournalEntry", "journal/send.ts — sendWanted() when the gate admits", "journal/entries.ts — entryOf()", "journal/send.ts (recording to sending), answers.ts, recovery.ts", "answers.ts (confirmed), recovery.ts (receipt found, Dismiss, dismissEntries), send.ts (write failed)"]
      row @e-origin-row cells=["Origin", "the owner machine that asks for the send; readers/submission-readers.ts on restore", "lift/journal.ts — routes the settlement", "never", "with its entry"]
      row @e-send-row cells=["SendWanted", "gesture, connection, forms, source, history, diagram (create), facade/editor-sends.ts", "journal/send.ts — sendWanted()", "never", "journal/send.ts — becomes an entry or a 'blocked' out"]
      row @e-stored-row cells=["StoredSubmission", "adapters/effects/storage.ts — on write-journal", "adapters/readers/submission-readers.ts", "storage.ts — whole list rewritten", "storage.ts — rewritten without it"]
      row @e-history-row cells=["History", "core/workspace/state.ts — initialWorkspace", "rules/gated-send.ts; view/journal-view.ts; rules/permissions.ts", "history/history.ts; rules/history-release.ts (gate to idle)", "never"]
      row @e-notices-row cells=["Notices", "core/workspace/state.ts — initialWorkspace", "view/status.ts; view/diagram-view.ts; rules/*.ts", "notices/notices.ts; rules/stale-uncertainty.ts; rules/note-expiry.ts", "never"]
    }
  }
  section @ownership "5 · Capability ownership — requests" mode=grid columns=1 order=6 {
    show @crud
  }

  node @s-new start "Send wanted" {}
  node @s-restored start "Restored from storage" {}
  node @s-recording state "recording" { text @d "storage write before the post" }
  node @s-sending state "sending" {}
  node @s-uncertain state "uncertain" { text @d "did it save? nobody knows yet" }
  node @s-checking state "checking" {}
  node @s-lookup state "looking-up" { text @d "Retry looks for a receipt first" }
  node @s-retryable state "retryable" { text @d "no receipt found" }
  node @s-rejected state "rejected" { text @d "shown in the problem bar" }
  node @s-confirmed end "Removed: confirmed" {}
  node @s-dismissed end "Removed: dismissed" {}
  node @s-unsaved end "Removed: never sent" { text @d "blocked 'journal-unsaved'" }

  wire @s1 @s-new -> @s-recording "send-wanted" kind=transition guard="gatedSend admits" effect="write-journal (before-send)"
  wire @s2 @s-recording -> @s-sending "written ok" kind=transition effect="post-apply"
  wire @s3 @s-recording -> @s-unsaved "write failed (new send)" kind=transition
  wire @s18 @s-recording -> @s-retryable "write failed (Retry)" kind=transition effect="report journal-unsaved"
  wire @s4 @s-sending -> @s-confirmed "committed" kind=transition guard="receipt names this request" effect="carried snapshot installs"
  wire @s5 @s-sending -> @s-rejected "refused" kind=transition guard="the apply executor classified it refused (8 codes)"
  wire @s6 @s-sending -> @s-uncertain "unknown" kind=transition
  wire @s7 @s-restored -> @s-uncertain "loaded" kind=transition guard="same workspace, not rejected"
  wire @s8 @s-uncertain -> @s-checking "Check" kind=transition effect="read-receipt"
  wire @s9 @s-uncertain -> @s-lookup "Retry" kind=transition effect="read-receipt"
  wire @s10 @s-retryable -> @s-checking "Check" kind=transition
  wire @s11 @s-retryable -> @s-lookup "Retry" kind=transition
  wire @s12 @s-checking -> @s-confirmed "receipt found" kind=transition
  wire @s13 @s-checking -> @s-retryable "no receipt" kind=transition effect="note 'No receipt found'"
  wire @s14 @s-lookup -> @s-confirmed "receipt found" kind=transition
  wire @s15 @s-lookup -> @s-recording "no receipt" kind=transition guard="gatedSend(resend) admits" effect="same request, current generation"
  wire @s16 @s-lookup -> @s-retryable "no receipt" kind=transition guard="gate blocks"
  wire @s17 @s-rejected -> @s-dismissed "Dismiss, F2 or F3" kind=transition

  section @state-51 "7.1 · A request's life in the journal (lookup failure returns to the phase before)" mode=state layout=layered direction=down order=7 {
    show @s-new @s-restored @s-recording @s-sending @s-uncertain @s-checking @s-lookup @s-retryable @s-rejected @s-confirmed @s-dismissed @s-unsaved
    connect @s1 @s2 @s3 @s18 @s4 @s5 @s6 @s7 @s8 @s9 @s10 @s11 @s12 @s13 @s14 @s15 @s16 @s17
  }

  node @g-start start "Undo / Redo pressed" {}
  node @g-idle state "idle" {}
  node @g-sending state "sending" { text @d "the inverse request is in the journal" }
  node @g-settling state "settling" { text @d "waiting for a snapshot at or past the sequence" }
  node @g-caught state "caught-up" { text @d "waiting for the release rule (F4)" }

  wire @h1 @g-start -> @g-idle "start" kind=transition
  wire @h2 @g-idle -> @g-sending "requested" kind=transition guard="navigable (H1) and the builder gives a request" effect="send (origin history)"
  wire @h3 @g-sending -> @g-idle "blocked" kind=transition
  wire @h4 @g-sending -> @g-settling "settled" kind=transition effect="read-history; sequence = receipt, or latest if refused"
  wire @h5 @g-settling -> @g-caught "snapshot seen" kind=transition guard="sequence >= settling sequence"
  wire @h6 @g-caught -> @g-idle "F4 release" kind=transition guard="history version = snapshot version and display current and no render"
  wire @h7 @g-idle -> @g-sending "restored inverse" kind=transition

  section @state-52 "7.2 · The undo/redo gate (while not idle, edits wait with reason 'history-held')" mode=state layout=layered direction=right order=8 {
    show @g-start @g-idle @g-sending @g-settling @g-caught
    connect @h1 @h2 @h3 @h4 @h5 @h6 @h7
  }
}
