  node @j-recovery module "recovery.ts [NEW]" {
    signature @sig "updateRecovery" parameters=["state: BoundJournal", "event: RecoveryEvent", "context: GateContext"] returns="Step<Journal, JournalOut, JournalEffect>"
    signature @dismiss "dismissEntries" parameters=["state: BoundJournal", "requests: readonly RequestId[]"] returns="Step<Journal, JournalOut, JournalEffect>"
