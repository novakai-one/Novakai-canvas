  node @h-history module "history.ts [NEW]" { signature @sig "updateHistory" parameters=["state: History", "event: HistoryEvent", "context: HistoryContext", "deps: WorkflowDeps"] returns="Step<History, HistoryOut, HistoryEffect>" }
  node @h-gate module "gate.ts [CHANGE]" { signature @sig "observeSnapshot" parameters=["gate: Gate", "sequence: WorkspaceSequence"] returns="Gate" }
  node @h-navigable module "navigable.ts [NEW · moved]" { signature @sig "navigable" parameters=["history: History", "context: HistoryContext", "canvas: CanvasActivity"] returns="Permission" }
  node @h-journal module "journal.ts [DELETE]" {}
  node @n-state module "state.ts [NEW]" {}
  node @n-notices module "notices.ts [NEW]" { signature @sig "updateNotices" parameters=["state: Notices", "event: NoticesEvent"] returns="Step<Notices, never, never>" }
  node @r-gate module "gated-send.ts [NEW]" {
    signature @sig "gatedSend" parameters=["journal: BoundJournal", "context: GateContext", "send: SendWanted", "mode: SendMode"] returns="Result<AdmittedSend, SendBlock>"
    signature @ready "sendReadiness" parameters=["journal: Journal", "context: GateContext", "target: SendTarget", "skip: RequestId | 'none'"] returns="Result<Readiness, SendBlock>"
  }
  node @r-classes module "refusal-classes.ts [NEW]" {
    signature @sig "classifyApply" parameters=["problem: ForeignDiagnostic"] returns="{ kind: 'refused', refusal: Refusal } | { kind: 'unknown' }"
    signature @move "moveRefusalOf" parameters=["code: RefusedCode"] returns="'offer' | 'reject'"
  }
  node @e-submissions module "submissions.ts [DELETE]" {}
  node @w-journal interface "journal.ts [NEW]" {}
  node @w-history interface "history.ts [NEW]" {}
  node @w-notices interface "notices.ts [NEW]" {}
  node @w-gate interface "gate.ts [NEW]" {}
  node @c-submission interface "submission.ts [CHANGE]" {}
  node @x-compose module "executors.ts [collection 1]" { signature @sig "composeExecutors" parameters=["handles: ExecutorHandles"] returns="Execute" }
  node @x-apply module "apply.ts [NEW]" { signature @sig "createApplyExecutor" parameters=["client: ServiceClient", "decode: ReceiptDecoder"] returns="Executor<ApplyEffect, apply-answered>" }
  node @x-storage module "storage.ts [NEW]" { signature @sig "createStorageExecutor" parameters=["retention: DraftRetention", "readers: SubmissionReaders"] returns="Executor<StorageEffect, StorageAnswer>" }
  node @x-readers module "submission-readers.ts [CHANGE]" { signature @sig "createSubmissionReaders" parameters=["decode: RequestDecoder"] returns="SubmissionReaders" }
  node @x-session module "submission-session.ts [DELETE]" {}
  node @x-retention module "draft-retention.ts [CHANGE]" { signature @sig "createDraftRetention" parameters=["storage: Storage"] returns="DraftRetention" }
