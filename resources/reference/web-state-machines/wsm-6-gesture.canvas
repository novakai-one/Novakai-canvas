  node @e-gesture entity "Gesture" {
    field @phase "phase" type="'idle' | 'sending' | 'choosing' | 'applying'"
    field @capture "capture" type="GestureCapture (all but idle)"
    field @request "request" type="RequestId (sending, applying)"
    field @preview "preview" type="PreviewPlan (sending)"
    field @choices "choices" type="Choices (choosing, applying): the shown kind is inside it"
    field @cause "cause" type="'local' | 'server' (choosing)"
    text @i1 "invariant G1: request is a fresh RequestId for every send (plain move and each applied choice); request != capture.gesture"
    text @i2 "invariant G3: each gesture gets exactly one of confirmed, discard, reject, and only when it leaves this machine"
    text @i3 "invariant G4: phase 'choosing' is reached only from a refusal (local or server), never after a confirmed move"
  }
  node @e-capture entity "GestureCapture" {
    field @gesture "gesture" type="GestureId" key=primary
    field @intent "intent" type="I extends CanvasEditIntent (PlacementIntent in choosing and applying)"
    field @scene "scene" type="RenderId"
    field @stamp "stamp" type="SceneStamp"
    field @base "base" type="Snapshot"
    field @document "document" type="RenderDocument"
    field @generation "generation" type="TransportGeneration"
    text @i1 "invariant: current(capture) <=> same scene and stamp (a new session can reuse a stamp), the open collection listed at the captured revision, and the latest generation = the captured one"
  }
  node @e-choice entity "Choice (keyed by ChoiceKind in Choices)" {
    field @kind "key" type="ChoiceKind = 'expand' | 'rearrange' (the Choices key, not a field)" key=primary
    field @changes "changes" type="readonly Change[]"
    field @preview "preview" type="GeometryPreview"
    text @i1 "invariant G2: Choices = { shown: 'expand', expand: Choice, rearrange: Choice | 'none' } | { shown: 'rearrange', expand: Choice | 'none', rearrange: Choice }: at least one, the shown one present, no kind twice"
  }
  node @e-gplan entity "GesturePlan" {
    field @kind "kind" type="'no-change' | 'placeable' | 'unplaceable' | 'refused'"
    field @placeable "changes, preview" type="readonly Change[], PreviewPlan (placeable)"
    field @choices "capture, choices" type="GestureCapture<PlacementIntent>, Choices (unplaceable)"
    field @problem "problem" type="Diagnostic (refused)"
    text @i1 "invariant I5: the module path needs moduleMove = every entry in modules, >= 1 entry, nothing resized"
    text @i2 "invariant I6: duplicate and ancestor selections are refused before any send, on every placement"
    text @i3 "invariant G6: after a server refusal choices are offered only when moveRefusal[RefusedCode] = offer (constraint-conflict only; open decision Q3)"
  }

  wire @er1 @e-gesture.@capture -> @e-capture.@gesture "captured" kind=association from=1 to=0..1
  wire @er2 @e-gesture.@choices -> @e-choice.@kind "offers" kind=association from=1 to=0..many
  wire @er3 @e-gplan.@choices -> @e-choice.@kind "offers" kind=association from=1 to=0..many

  section @entities "2 · Entities and invariants — a gesture and its choices" mode=er direction=right order=2 {
    show @e-gesture @e-capture @e-choice @e-gplan
    connect @er1 @er2 @er3
  }

  wire @m1 @g-gesture -> @g-intake.@sig "receiveIntent(): Step<Gesture, GestureOut, GestureEffect>" kind=imports
  wire @m2 @g-gesture -> @g-choices.@sig "updateChoices(): Step<Gesture, GestureOut, GestureEffect>" kind=imports
  wire @m3 @g-gesture -> @g-settle.@sig "settleGesture(): Step<Gesture, GestureOut, GestureEffect>" kind=imports
  wire @m4 @g-intake -> @e-plan-g.@sig "planGesture(): GesturePlan" kind=imports
  wire @m5 @g-settle -> @e-plan-g.@choices "choicesAfterRefusal(): Choices | 'none'" kind=imports
  wire @m6 @g-intake -> @g-failures.@sig "gestureFailure(): Diagnostic" kind=imports
  wire @m7 @e-plan-g -> @e-module.@sig "moduleMove(): 'module-move' | 'plain'" kind=imports
  wire @m8 @e-plan-g -> @e-plan.@sig "planCanvasEdit(): Result<readonly Change[]>" kind=imports
