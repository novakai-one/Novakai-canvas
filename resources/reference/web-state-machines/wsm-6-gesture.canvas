  wire @m13 @c-workspace -> @x-preview.@sig "previewModuleRoutes(): Result<PreviewPlan> (injected as WorkflowDeps.preview)" kind=imports
  wire @m14 @x-preview -> @c-api.@sig "moduleMove(): 'module-move' | 'plain'" kind=imports

  section @modules "3.1 · Module imports — the gesture machine" mode=modules layout=layered direction=right order=3 {
