  node @s-idle start "idle" {}
  node @s-sending state "sending" { text @d "plain move sent; waits through uncertain and retryable" }
  node @s-choosing state "choosing" { text @d "Expand / Rearrange shown; nothing sent" }
  node @s-applying state "applying" { text @d "one choice sent with a fresh request" }
  node @s-saved end "Saved" { text @d "Canvas 'confirmed' once the newer scene shows" }
  node @s-back end "Snaps back" { text @d "Canvas 'reject' + message" }
  node @s-quiet end "Nothing happens" { text @d "Canvas 'discard'" }

  wire @s1 @s-idle -> @s-sending "drop" kind=transition guard="placeable" effect="send plain move (fresh RequestId)"
  wire @s2 @s-idle -> @s-choosing "drop" kind=transition guard="unplaceable (local refusal)" effect="preview the first choice at once"
  wire @s4 @s-sending -> @s-saved "confirmed" kind=transition
  wire @s4b @s-sending -> @s-back "refused" kind=transition guard="no choices offered"
  wire @s5 @s-sending -> @s-choosing "refused" kind=transition guard="constraint-conflict, placement, capture current, choices exist" effect="preview the first choice"
  wire @s6 @s-choosing -> @s-choosing "option shown" kind=transition effect="preview that choice"
  wire @s7 @s-choosing -> @s-applying "Apply" kind=transition guard="may.applyMove and capture current" effect="send (fresh RequestId)"
  wire @s8 @s-applying -> @s-choosing "refused or blocked" kind=transition effect="re-show the same choice"
  wire @s9 @s-applying -> @s-saved "confirmed" kind=transition
  wire @s10 @s-choosing -> @s-quiet "Cancel" kind=transition effect="status 'Movement cancelled'"
  wire @s10b @s-choosing -> @s-back "diagram changed" kind=transition

  section @state-51 "7.1 · A gesture's life once a drop moves something (drops that change nothing or are refused at once: 7.2)" mode=state layout=layered direction=right order=8 {
    show @s-idle @s-sending @s-choosing @s-applying @s-saved @s-back @s-quiet
    connect @s1 @s2 @s4 @s4b @s5 @s6 @s7 @s8 @s9 @s10 @s10b
  }

  node @f-drop start "You drop a node" {}
  node @f-busy decision "Another move is under way?" {}
  node @f-refuse end "Snaps back, with a message" { text @d "movement-active, duplicate or ancestor selection, invalid edit" }
  node @f-valid decision "Valid selection?" {}
  node @f-change decision "Did anything move?" {}
  node @f-quiet end "Nothing happens (quiet discard)" {}
  node @f-fits decision "Can it be placed as dropped? (local preview)" {}
  node @f-send step "Send the plain move" { text @d "fresh request; preview drawn once the send starts" }
  node @f-answer decision "Authoring's answer" {}
  node @f-saved end "Saved" {}
  node @f-choices step "Show Expand / Rearrange" { text @d "disabled with a reason while a request is sending, uncertain or retryable" }
  node @f-apply end "Apply one: sent with a new request" {}

  wire @fw1 @f-drop -> @f-busy "check" kind=flow step=1
  wire @fw2 @f-busy -> @f-refuse "yes" kind=flow style=dashed
  wire @fw3 @f-busy -> @f-valid "no" kind=flow step=2
  wire @fw4 @f-valid -> @f-refuse "no" kind=flow style=dashed
  wire @fw5 @f-valid -> @f-change "yes" kind=flow step=3
  wire @fw6 @f-change -> @f-quiet "no" kind=flow
  wire @fw7 @f-change -> @f-fits "yes" kind=flow step=4
  wire @fw8 @f-fits -> @f-send "yes" kind=flow
  wire @fw9 @f-fits -> @f-choices "no — refused locally, no server trip" kind=flow
  wire @fw10 @f-send -> @f-answer "wait" kind=flow step=5
  wire @fw11 @f-answer -> @f-saved "committed" kind=flow
  wire @fw12 @f-answer -> @f-choices "constraint-conflict" kind=flow
  wire @fw13 @f-answer -> @f-refuse "any other refusal" kind=flow style=dashed
  wire @fw14 @f-choices -> @f-apply "Apply" kind=flow step=6

  section @flow-52 "7.2 · A drop, in plain words" mode=flow layout=layered direction=down order=9 {
    show @f-drop @f-busy @f-refuse @f-valid @f-change @f-quiet @f-fits @f-send @f-answer @f-saved @f-choices @f-apply
    connect @fw1 @fw2 @fw3 @fw4 @fw5 @fw6 @fw7 @fw8 @fw9 @fw10 @fw11 @fw12 @fw13 @fw14
  }
}
