      row @e-gesture-row cells=["Gesture", "core/workspace/state.ts via diagram/state.ts (idle, per open diagram)", "view/editing-view.ts (movementReview); rules/permissions.ts; rules/flags.ts", "gesture/intake.ts, choices.ts, settle.ts", "diagram/render.ts — dropped when another collection installs (I14)"]
      row @e-capture-row cells=["GestureCapture", "gesture/intake.ts — receiveIntent()", "gesture/choices.ts, settle.ts — the current check", "never", "gesture/settle.ts, choices.ts — on return to idle"]
      row @e-choice-row cells=["Choice", "core/editing/gesture-plan.ts — planGesture() or choicesAfterRefusal()", "gesture/choices.ts; adapters/effects/scene.ts (preview)", "never", "gesture/choices.ts — cancel, apply confirmed, or diagram changed"]
