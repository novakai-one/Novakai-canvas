  section @ownership "5 · Capability ownership — identities and diagnostics" mode=grid columns=1 order=5 {
    show @crud
  }

  node @f-person start "A person clicks Add, or drops on the Canvas" {}
  node @f-facade step "Facade or Canvas intake asks IdSource" {}
  node @f-random step "random() — the one crypto.randomUUID" {}
  node @f-check decision "Owner schema accepts it? (safeParse)" {}
  node @f-event step "Event carries the branded ID into core" {}
  node @f-report end "Report 'id-unavailable'; the draft is kept" {}
  node @f-core end "Core uses it; core never mints" {}

  wire @fw1 @f-person -> @f-facade "action" kind=flow step=1
  wire @fw2 @f-facade -> @f-random "new value" kind=flow step=2
  wire @fw3 @f-random -> @f-check "check" kind=flow step=3
  wire @fw4 @f-check -> @f-event "yes" kind=flow step=4
  wire @fw5 @f-check -> @f-report "no" kind=flow style=dashed
  wire @fw6 @f-event -> @f-core "dispatch" kind=flow step=5

  section @flow-51 "7 · Where a new ID comes from" mode=flow layout=layered direction=right order=6 {
    show @f-person @f-facade @f-random @f-check @f-event @f-report @f-core
    connect @fw1 @fw2 @fw3 @fw4 @fw5 @fw6
  }
}
