  node @e-diagnostic entity "Diagnostic" {
    field @origin "origin" type="'web' | 'authoring' | 'service' | 'canvas' | 'library' | 'layout' | 'language' | 'unrecognised'"
    field @code "code" type="WebErrorCode (web) | that owner's closed code union (each foreign origin) | 'unrecognised-failure'"
    field @text "message, recovery" type="string, string (content)"
    field @source "source" type="the owner's own failure record (foreign only): OperationSource, CanvasDiagnostic, LibraryDiagnostic, …"
    field @cause "cause" type="ForeignDiagnostic (web only; key omitted when none)"
    text @i1 "invariant: consumers branch on origin and code only, never on message; 'owner' is gone (ProblemSlot.shown says where)"
    text @i2 "invariant: the executor that called an endpoint names its owner once (authoring for apply and receipt); a code outside that owner's union => 'unrecognised-failure', raw failure kept in source"
  }
  node @e-minted entity "Minted ID" {
    field @kind "kind" type="'request' | 'collection' | 'section' | 'object' | 'group' | 'relationship' | 'definition' | 'descendant' | 'folder'"
    field @value "value" type="RequestId | CollectionId | SectionId | ObjectId | GroupId | RelationshipId | DefinitionId | DescendantId | FolderId" key=primary
    field @text "text" type="'<uuid>' (request) or '<kind>-<uuid>' (collection-, section-, object-, group-, relationship-, definition-, content-, folder-)"
    text @i1 "invariant: minted only by adapters/edge/ids.ts, checked with the owner's schema by safeParse; failure = 'id-unavailable'"
    text @i2 "invariant: crypto.randomUUID is called once, in contract/compose/workspace.ts; core never mints"
  }
  node @e-gesture entity "GestureId (Canvas brand)" {
    field @value "value" type="GestureId" key=primary
    text @i1 "invariant: Canvas parses the host's random text when a gesture begins (gesture-ids.ts); parse fails => no gesture starts"
    text @i2 "invariant: GestureId and RequestId are different brands; neither converts to the other"
  }
  node @e-generation entity "TransportGeneration (Service brand)" {
    field @value "value" type="TransportGeneration (1 to 128 characters)" key=primary
    text @i1 "invariant: parsed by the service envelope schemas, and by the web readers of stored drafts with the same Service schema; '' becomes 'unread'"
  }
  node @e-count entity "Count ticket" {
    field @brand "brand" type="'SourceEdit' | 'ReadTicket' | 'HistoryTicket' | 'RenderId' | 'JournalTick'"
    field @value "value" type="integer, 0 <= value <= MAX_SAFE_INTEGER"
    text @i1 "invariant: next = nextCount(schema, current) = current + 1; only the owning machine folder may import the schema (ESLint importNames); at the maximum it stays"
    text @i2 "invariant: only SourceEdit is stored; the reader reuses its schema"
  }
  node @e-draftkey entity "Draft key" {
    field @kind "kind" type="ObjectDraftKey | WireDraftKey | DefinitionDraftKey"
    field @parts "built from" type="CollectionId + ObjectId | SectionId + RelationshipId | DefinitionId"
    text @i1 "invariant: made only by the three key functions; readers rebuild the key and reject a stored key that differs"
  }
  node @e-slot entity "Storage key" {
    field @slot "slot" type="RetentionSlot (9 values)"
    field @workspace "workspace" type="WorkspaceId"
    text @i1 "invariant: the key text is built only in adapters/sessions/draft-retention.ts"
  }

  wire @er1 @e-draftkey.@parts -> @e-minted.@value "built from" kind=association from=1 to=1..many
  wire @er2 @e-slot.@slot -> @e-draftkey.@kind "holds drafts keyed by" kind=association from=1 to=0..many
  wire @er3 @e-gesture.@value -> @e-minted.@value "never converted to a RequestId" kind=association from=1 to=0..1

  section @entities "2 · Entities and invariants — identities and diagnostics" mode=er direction=right order=2 {
    show @e-diagnostic @e-minted @e-gesture @e-generation @e-count @e-draftkey @e-slot
    connect @er1 @er2 @er3
  }

  wire @m1 @w-compose -> @x-ids.@sig "createIdSource(): IdSource" kind=imports
