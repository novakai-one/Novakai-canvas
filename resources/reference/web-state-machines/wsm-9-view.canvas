    table @crud-t columns=["Object", "Create", "Read", "Update", "Delete"] {
      row @e-view-row cells=["ProjectedView", "core/workspace/view/project.ts — projectWorkspace()", "adapters/runner/runner.ts — getSnapshot() cache", "never; a new one per new state", "runner — replaced on the next state"]
      row @e-permissions-row cells=["Permissions", "core/workspace/rules/permissions.ts — permissions()", "React components; diagram/children.ts (SceneContext.may)", "never", "with its view"]
      row @e-permission-row cells=["Permission", "rules/permissions.ts", "React components (disabled + reason)", "never", "with its view"]
      row @e-wview-row cells=["WorkspaceView", "adapters/facade/view.ts — getSnapshot()", "WorkspaceShell.tsx — useSyncExternalStore", "never", "facade — replaced when the projection or session handle changes"]
      row @e-waiter-row cells=["Waiter", "adapters/facade/editor-sends.ts — on each editor apply", "adapters/runner/waiters.ts", "waiters.ts — answer-caller resolves it", "waiters.ts — after resolving; all dropped on dispose"]
    }
  }
  section @ownership "5 · Capability ownership — the view" mode=grid columns=1 order=8 {
    show @crud
  }

  node @z-start start "Build the status line" {}
  node @z-1 decision "1 · Opening, switching or a chooser failure?" {}
  node @z-2 decision "2 · A problem is shown?" {}
  node @z-3 decision "3 · A request is recording or sending?" {}
  node @z-4 decision "4 · Move choices shown?" {}
  node @z-5 decision "5 · New connection being edited?" {}
  node @z-6 decision "6 · A status note is set?" {}
  node @z-t1 end "'Rendering diagram…' · 'Opening {title}…' · 'Could not open {title}'" {}
  node @z-t2 end "open failure: its message; else 'Action failed. See the error above.'" {}
  node @z-t3 end "'Saving…'" {}
  node @z-t4 end "'Review movement options'" {}
  node @z-t5 end "'Review new connection'" {}
  node @z-t6 end "The note: 'Movement cancelled', 'No receipt found…', 'Collection is no longer available', 'Add to … was not applied'" {}
  node @z-t7 end "7 · Resting: 'Connecting…' · 'Ready' · 'Draft not applied' · 'Edit awaiting confirmation' · 'Saved'" {}

  wire @zw0 @z-start -> @z-1 "first match wins" kind=flow step=1
  wire @zw1 @z-1 -> @z-t1 "yes" kind=flow
  wire @zw2 @z-1 -> @z-2 "no" kind=flow
  wire @zw3 @z-2 -> @z-t2 "yes" kind=flow
  wire @zw4 @z-2 -> @z-3 "no" kind=flow
  wire @zw5 @z-3 -> @z-t3 "yes" kind=flow
  wire @zw6 @z-3 -> @z-4 "no" kind=flow
  wire @zw7 @z-4 -> @z-t4 "yes" kind=flow
  wire @zw8 @z-4 -> @z-5 "no" kind=flow
  wire @zw9 @z-5 -> @z-t5 "yes" kind=flow
  wire @zw10 @z-5 -> @z-6 "no" kind=flow
  wire @zw11 @z-6 -> @z-t6 "yes" kind=flow
  wire @zw12 @z-6 -> @z-t7 "no" kind=flow

  section @flow-51 "7.1 · Status text is derived by fixed priority (same wording as today)" mode=flow layout=layered direction=down order=9 {
    show @z-start @z-1 @z-2 @z-3 @z-4 @z-5 @z-6 @z-t1 @z-t2 @z-t3 @z-t4 @z-t5 @z-t6 @z-t7
    connect @zw0 @zw1 @zw2 @zw3 @zw4 @zw5 @zw6 @zw7 @zw8 @zw9 @zw10 @zw11 @zw12
  }
}
