  node @e-view entity "ProjectedView" {
    field @diagram "diagram" type="DiagramView: snapshot, generation, collections, connected, opening, collectionSwitch (idle | choosing | loading | failed), problem"
    field @journal "journal" type="JournalView: pending (PendingView rows with check, retry, dismiss permissions), newestRefusal"
    field @history "history" type="HistoryView: status known or null"
    field @editing "editing" type="EditingView: creation (drafts, note, adding), movementReview, connection + requestState"
    field @source "source" type="SourceView: phase, panel, text, readout"
    field @status "status" type="string (display text, derived)"
    field @may "may" type="Permissions"
    text @i0 "invariant D6: no busy, history.busy or creation.busy; 'can I act now?' has one answer, may"
    text @i1 "invariant: view = projectWorkspace(state); pure; cached per state reference, so an unchanged state gives the same object (R8)"
    text @i2 "invariant: null and boolean appear only here, as 'nothing to draw' and derived flags; stored state has none"
    text @i3 "invariant: status = the first matching row of the status table (7.1); stored status text does not exist"
  }
  node @e-permissions entity "Permissions" {
    field @fields "undo · redo · applyEdits · applySource · library · createCollection · addForms · chooseMove · applyMove · cancelMove · editConnection · applyConnection" type="Permission"
    text @i1 "invariant: each send permission = sendReadiness(target) + phase checks; gatedSend runs the same sendReadiness first, and the gesture machine reads the same may.applyMove"
  }
  node @e-permission entity "Permission" {
    field @kind "kind" type="'allowed' | 'blocked'"
    field @reason "reason" type="BlockReason = SendBlock | 'offline' | 'saving' | 'uncertain' | 'retryable' | 'checking' | 'no-diagram' | 'nothing-to-undo' | 'nothing-to-redo' | 'status-unknown' | 'move-in-progress' | 'form-locked' | 'connection-sent' | 'diagram-changed' | 'stored-draft-kept' | 'not-refused'"
    text @i1 "invariant: kind = 'blocked' <=> reason present; React shows the reason instead of reporting an error (I10)"
  }
  node @e-wview entity "WorkspaceView (what React reads)" {
    field @projected "projected" type="ProjectedView"
    field @active "active" type="ActiveDiagram | null (live Canvas session and canvas, attached by the facade)"
    text @i1 "invariant: memoised by the identities of the projection and the session handle; each React feature gets its own part and command set; React holds no second copy"
  }
  node @e-waiter entity "Waiter (editor store apply)" {
    field @request "request" type="RequestId" key=primary
    field @answer "answer" type="'waiting' | Result<Receipt>"
    text @i1 "invariant: resolved exactly once, by the answer-caller effect, when the entry settles, turns uncertain or is blocked"
  }

  wire @er1 @e-view.@may -> @e-permissions "has" kind=association from=1 to=1
  wire @er2 @e-permissions.@fields -> @e-permission "12 of" kind=association from=1 to=1..many
  wire @er3 @e-wview.@projected -> @e-view "wraps" kind=association from=1 to=1

  section @entities "2 · Entities and invariants — the view React reads" mode=er direction=right order=3 {
    show @e-view @e-permissions @e-permission @e-wview @e-waiter
    connect @er1 @er2 @er3
  }

